\section*{Notation}

\noindent
$K$ sources and microphones, $F$ frequency bins, $t$ the frame index.
$\xft \in \mathbb{C}^{K}$ is the observed frame, $\Wf \in \mathbb{C}^{K \times K}$
the demixing matrix with rows $\wkf\herm$, and $\yft = \Wf \xft$ the separated
frame. $\bm{U}_{kf} \in \mathbb{C}^{K \times K}$ is the weighted covariance of
source $k$, $\alpha \in [0,1)$ the forgetting factor, $N_{\mathrm{iter}}$ the
number of sweeps per frame, and $\bm{e}_{k}$ the $k$th canonical basis vector.
$\mathcal{I}_{t} \subseteq \{1,\dots,K\}$ is the set of source indices updated
at frame $t$: all of them before convergence, and only the moving sources
afterwards.

The source model enters through the weighting function
\begin{equation}
  \varphi(r) =
  \begin{cases}
    1/(2r), & \text{spherical Laplace},\\[2pt]
    F/r^{2}, & \text{time-varying Gaussian},
  \end{cases}
  \label{eq:phi}
\end{equation}
evaluated at $r_{kt} = \bigl(\sum_{f} |\wkf\herm \xft|^{2}\bigr)^{1/2}$.

% ---------------------------------------------------------------------------
\begin{algorithm}[t]
\caption{Online AuxIVA-ISS}
\label{alg:iss}
\begin{algorithmic}[1]
\Require observed frames $\xft$; sweeps $N_{\mathrm{iter}}$; forgetting factor
         $\alpha$; initial $\bm{W}_{f0}$, $\bm{U}_{kf0}$
\Ensure  separated frames $\yft$
\For{$t = 1, \dots, T$}
  \State $\Wf \gets \bm{W}_{f(t-1)}$ \quad $(\forall f)$
  \State $\widetilde{\bm{U}}_{kf} \gets \bm{U}_{kf(t-1)}$ \quad $(\forall k, f)$
         \Comment{anchor for \eqref{eq:cov}}
  \For{$\mathrm{iter} = 1, \dots, N_{\mathrm{iter}}$}
    \For{$k = 1, \dots, K$}
      \Comment{all $k$: covariances are shared state}
      \State $r_{kt} \gets \bigl(\sum_{f} |\wkf\herm \xft|^{2}\bigr)^{1/2}$
      \State $\bm{U}_{kf} \gets \alpha \widetilde{\bm{U}}_{kf}
              + (1-\alpha)\, \varphi(r_{kt})\, \xft \xft\herm$
              \quad $(\forall f)$
    \EndFor
    \For{$k \in \mathcal{I}_{t}$}
      \State $\bm{p}_{f} \gets \wkf\herm$ \quad $(\forall f)$
             \Comment{snapshot: row $k$ before the update}
      \For{$m = 1, \dots, K$}
        \If{$m \neq k$}
          \State $v_{mkf} \gets \dfrac{\bm{w}_{mf}\herm \bm{U}_{mf} \wkf}
                                      {\wkf\herm \bm{U}_{mf} \wkf}$
                 \quad $(\forall f)$
        \Else
          \State $v_{kkf} \gets 1 - \bigl(\wkf\herm \bm{U}_{kf} \wkf\bigr)^{-1/2}$
                 \quad $(\forall f)$
        \EndIf
        \State $\bm{w}_{mf}\herm \gets \bm{w}_{mf}\herm - v_{mkf}\, \bm{p}_{f}$
               \quad $(\forall f)$
      \EndFor
    \EndFor
  \EndFor
  \State $\yft \gets \Wf \xft$ \quad $(\forall f)$
\EndFor
\end{algorithmic}
\end{algorithm}

% ---------------------------------------------------------------------------
\begin{algorithm}[t]
\caption{Online AuxIVA-IP (baseline)}
\label{alg:ip}
\begin{algorithmic}[1]
\Require observed frames $\xft$; sweeps $N_{\mathrm{iter}}$; forgetting factor
         $\alpha$; initial $\bm{W}_{f0}$, $\bm{U}_{kf0}$
\Ensure  separated frames $\yft$
\For{$t = 1, \dots, T$}
  \State $\Wf \gets \bm{W}_{f(t-1)}$ \quad $(\forall f)$
  \State $\widetilde{\bm{U}}_{kf} \gets \bm{U}_{kf(t-1)}$ \quad $(\forall k, f)$
  \For{$\mathrm{iter} = 1, \dots, N_{\mathrm{iter}}$}
    \For{$k = 1, \dots, K$}
      \State $r_{kt} \gets \bigl(\sum_{f} |\wkf\herm \xft|^{2}\bigr)^{1/2}$
      \State $\bm{U}_{kf} \gets \alpha \widetilde{\bm{U}}_{kf}
              + (1-\alpha)\, \varphi(r_{kt})\, \xft \xft\herm$
              \quad $(\forall f)$
    \EndFor
    \For{$k \in \mathcal{I}_{t}$}
      \State $\wkf \gets \bigl(\Wf \bm{U}_{kf}\bigr)^{-1} \bm{e}_{k}$
             \quad $(\forall f)$
             \Comment{$O(K^{3})$ solve}
      \State $\wkf \gets \wkf \big/ \bigl(\wkf\herm \bm{U}_{kf} \wkf\bigr)^{1/2}$
             \quad $(\forall f)$
    \EndFor
  \EndFor
  \State $\yft \gets \Wf \xft$ \quad $(\forall f)$
\EndFor
\end{algorithmic}
\end{algorithm}

